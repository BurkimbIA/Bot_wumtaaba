# Copier vers .env et remplir localement. Ne jamais committer les valeurs secrètes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
GEMINI_API_KEY=
GRAPH_VERSION=v25.0
TRANSCRIPTION_MODEL=gemini-3.8-flash
EXTRACTION_MODEL=gemini-3.8-flash
# Numéros des testeurs autorisés, format international sans +, séparés par virgules.
# Vide = aucun utilisateur autorisé (pilote fermé).
ALLOWED_SENDERS=
DATABASE_PATH=data/bot.sqlite3
MAX_AUDIO_BYTES=14000000
MAX_MESSAGES_PER_HOUR=30
# 0 = conserver sans purge automatique.
RETENTION_DAYS=0
MEDIA_DIRECTORY=data/media
REMINDER_ENABLED=true
# Renseigner uniquement après approbation Meta (langue fr, 3 paramètres).
REMINDER_TEMPLATE_NAME=
REMINDER_TEMPLATE_LANGUAGE=fr
SUPPORT_CONTACT=L’équipe Wuumtaaba
