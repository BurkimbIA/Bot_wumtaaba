# Copier vers .env et remplir localement. Ne jamais committer les valeurs secrètes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
GEMINI_API_KEY=
GRAPH_VERSION=v25.0
TRANSCRIPTION_MODEL=gemini-3.8-flash
EXTRACTION_MODEL=gemini-3.8-flash
# true = tous les numéros peuvent utiliser le bot ; false = pilote fermé.
PUBLIC_ACCESS=false
# Numéros des testeurs autorisés, format international sans +, séparés par virgules.
# Utilisé uniquement en pilote fermé.
ALLOWED_SENDERS=
# Pooler de session Supabase (port 5432), mot de passe encodé pour une URL (? devient %3F).
DATABASE_URL=postgresql://postgres.iagyxtstnbgstdyppgnp:[MOT-DE-PASSE]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=wuumtaaba
SUPABASE_URL=https://iagyxtstnbgstdyppgnp.supabase.co
# Clé secrète du projet (Settings > API keys), pour le bucket privé des audios.
SUPABASE_API_KEY=
MEDIA_BUCKET=wuumtaaba-media
# Annotation audio: existing private Tigris bucket. Keys remain server-side.
ANNOTATION_BUCKET=burkimbia-store
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Secondes sans travail avant que le bot s'arrête lui-même ; 0 = jamais (local).
IDLE_SHUTDOWN_SECONDS=0
MAX_AUDIO_BYTES=14000000
MAX_MESSAGES_PER_HOUR=30
# 0 = conserver sans purge automatique.
RETENTION_DAYS=0
REMINDER_ENABLED=true
# Renseigner uniquement après approbation Meta (langue fr, 3 paramètres).
REMINDER_TEMPLATE_NAME=
REMINDER_TEMPLATE_LANGUAGE=fr
SUPPORT_CONTACT=L’équipe Wuumtaaba

# Accès back-office : code aléatoire de 24 caractères minimum.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=true

# Plateforme BurkimbIA — clé dédiée, jamais dans Git.
BURKIMBIA_API_URL=https://bia-backend.fly.dev/api/v1
BURKIMBIA_API_KEY=
BURKIMBIA_TRANSLATION_MODEL=bia-translation-v1-fast
BURKIMBIA_TIMEOUT_SECONDS=330
# Yaaba reste indiqué indisponible tant qu’un endpoint réel n’est pas raccordé.
BURKIMBIA_YAABA_ENABLED=false

# Private outbound Mac connector (generate >=32 random characters)
MAC_BRIDGE_API_KEY=

# Optional French summary readback, using the existing Gemini key.
FRENCH_TTS_MODEL=gemini-3.1-flash-tts-preview

# Wumtaaba Check : accès direct RunPod (clé uniquement côté serveur)
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TRANSCRIPTION_ENDPOINT_ID=
RUNPOD_SPEECH_ENDPOINT_ID=
RUNPOD_TIMEOUT_SECONDS=330
