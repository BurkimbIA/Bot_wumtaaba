# Copier vers .env et remplir localement. Ne jamais committer les valeurs secrètes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
OPENAI_API_KEY=
GRAPH_VERSION=v25.0
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EXTRACTION_MODEL=gpt-4o-mini
# Numéros des testeurs autorisés, format international sans +, séparés par virgules.
# Vide = aucun utilisateur autorisé (pilote fermé).
ALLOWED_SENDERS=
DATABASE_PATH=data/bot.sqlite3
MAX_AUDIO_BYTES=16000000
MAX_MESSAGES_PER_HOUR=30
RETENTION_DAYS=30
SUPPORT_CONTACT=L’équipe Wuumtaaba
